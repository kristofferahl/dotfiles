#!/usr/bin/env bash

# paths
PATH="/opt/homebrew/bin:$PATH"
PATH="${PATH}:${HOME}/.krew/bin"
PATH="${HOME}/.local/bin:$PATH"

# go paths
export GOPATH="$HOME/develop/go"
export GOBIN="${GOPATH:?}/bin"
export PATH="${GOBIN:?}:${PATH:?}"

# starship
export STARSHIP_CONFIG="${DOTFILES_DIR:?}/.config/starship.toml"

# zellij
export ZELLIJ_CONFIG_DIR="${DOTFILES_DIR:?}/.config/zellij"

# herdr
export HERDR_CONFIG_PATH="${DOTFILES_DIR:?}/.config/herdr/config.toml"

# fd
export FD_OPTIONS='--hidden --exclude .git/'

# fzf
export FZF_DEFAULT_COMMAND="fd $FD_OPTIONS"
export FZF_DEFAULT_OPTS="--bind='ctrl-o:execute(vim {})+abort' --bind='ctrl-p:toggle-preview' --preview '[[ \$(file --mime {}) =~ binary ]] && echo Preview not available for {} || (bat --style=numbers --color=always --line-range :500 {} || cat {}) 2>/dev/null' --preview-window hidden"
export FZF_CTRL_T_COMMAND="fd $FD_OPTIONS"
export FZF_CTRL_T_OPTS="--preview 'bat --style=numbers --color=always --line-range :500 {}' --preview-window hidden"
export FZF_ALT_C_COMMAND="fd --type d $FD_OPTIONS"
export FZF_ALT_C_OPTS="--preview 'eza --tree -L 3 --classify=always --color=always {}' --preview-window nohidden"

# gpg
export GPG_TTY=$(tty)

# default editor
export EDITOR="vim"
